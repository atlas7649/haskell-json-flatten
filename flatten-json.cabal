name:                flatten-json
version:             0.1.0.0
category:            Data
build-type:          Simple
cabal-version:       >=1.10

library
  exposed-modules:     Flatten
  build-depends:       base >= 4.7 && < 5, aeson, unordered-containers, text
  hs-source-dirs:      src
  default-language:    Haskell2010

executable flatten-json-cli
  main-is:             Main.hs
  build-depends:       base >= 4.7 && < 5, flatten-json, aeson, bytestring
  hs-source-dirs:      app
  default-language:    Haskell2010